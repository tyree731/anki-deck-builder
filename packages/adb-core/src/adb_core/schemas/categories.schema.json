{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Categorize-phase decisions: deck name, sources (one subdeck each), topic taxonomy and page assignments",
  "type": "object",
  "required": ["deck_root", "audience", "sources", "topics", "page_sources", "page_topics"],
  "additionalProperties": false,
  "properties": {
    "deck_root": {"type": "string", "minLength": 3, "pattern": "^(?!.*::).+$"},
    "audience": {"type": "string", "minLength": 2},
    "purpose": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "subdeck", "description", "order"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "subdeck": {"type": "string", "minLength": 1, "pattern": "^(?!.*::).+$"},
          "description": {"type": "string"},
          "order": {"type": "integer", "minimum": 1}
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "label", "order"],
        "additionalProperties": false,
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1}
        }
      }
    },
    "page_sources": {
      "type": "object",
      "patternProperties": {"^p\\d{3,4}$": {"type": "string"}},
      "additionalProperties": false
    },
    "page_topics": {
      "type": "object",
      "patternProperties": {"^p\\d{3,4}$": {"type": "array", "items": {"type": "string"}}},
      "additionalProperties": false
    },
    "skip_pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "reason"],
        "additionalProperties": false,
        "properties": {"page": {"type": "string", "pattern": "^p\\d{3,4}$"}, "reason": {"type": "string", "minLength": 3}}
      }
    },
    "cross_source_notes": {"type": "array", "items": {"type": "string"}}
  }
}
