{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthesize-phase card file: a JSON array of notes written by one author subset",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["key", "type", "source", "topic", "origin", "pages"],
    "additionalProperties": false,
    "properties": {
      "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$", "maxLength": 80},
      "type": {"enum": ["basic", "cloze", "diagram"]},
      "source": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "topic": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "section": {"type": "string"},
      "origin": {"enum": ["source", "derived", "model_answer", "model_goal", "correction"]},
      "correction": {"type": "string", "minLength": 3},
      "pages": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^p\\d{3,4}$"}},
      "front": {"type": "string", "minLength": 1},
      "back": {"type": "string", "minLength": 1},
      "text": {"type": "string", "pattern": "\\{\\{c\\d+::"},
      "prompt": {"type": "string", "minLength": 1},
      "masked": {"type": "string", "minLength": 1},
      "answer": {"type": "string", "minLength": 1},
      "answer_image": {"type": "string", "minLength": 1},
      "extra": {"type": "string"},
      "images": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_:]+$"}}
    },
    "allOf": [
      {"if": {"properties": {"type": {"const": "basic"}}}, "then": {"required": ["front", "back"], "not": {"anyOf": [{"required": ["text"]}, {"required": ["prompt"]}]}}},
      {"if": {"properties": {"type": {"const": "cloze"}}}, "then": {"required": ["text"], "not": {"anyOf": [{"required": ["front"]}, {"required": ["prompt"]}]}}},
      {"if": {"properties": {"type": {"const": "diagram"}}}, "then": {"required": ["prompt", "masked", "answer", "answer_image"], "not": {"anyOf": [{"required": ["front"]}, {"required": ["text"]}]}}},
      {"if": {"properties": {"origin": {"const": "correction"}}}, "then": {"required": ["correction"]}}
    ]
  }
}
