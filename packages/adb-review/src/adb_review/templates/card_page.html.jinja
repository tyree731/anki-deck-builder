<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>{{ css }}</style>
<style>
body { margin:0; background:#888; font-family:-apple-system,Arial; }
.wrap { display:flex; gap:12px; padding:8px; align-items:flex-start; }
.side { width:{{ width }}px; background:#fff; min-height:200px; padding-bottom:12px; }
.side .img img, .side .q img { max-height:{{ img_max_h }}px !important; }
.lbl { font:bold 18px Arial; color:#fff; padding:6px 8px; background:#333; }
</style>
</head>
<body>
<div class="lbl">{{ label }}</div>
<div class="wrap">
<div class="side"><div class="lbl" style="background:#0a62c9">QUESTION (front)</div><div class="card">{{ question }}</div></div>
<div class="side"><div class="lbl" style="background:#1a7f37">ANSWER (back, after reveal)</div><div class="card">{{ answer }}</div></div>
</div>
</body>
</html>
